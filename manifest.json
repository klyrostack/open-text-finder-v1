{
  "manifest_version": 3,
  "name": "Open Text Finder",
  "version": "2.0.0",
  "description": "Search visible text across open Chrome tabs, preview matches, and jump to highlighted results.",
  "background": { "service_worker": "worker.js" },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Open Text Finder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+F" } }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
